# Supabase Postgres "Transaction pooler" connection string (port 6543).
# The app uses this at runtime — it is the pooled, serverless-friendly one.
# See SETUP.md for where to find it.
DATABASE_URL=""

# Supabase "Direct connection" string (port 5432, no pooler).
# Used exclusively by `prisma migrate` / `prisma studio` / `npm run db:seed`.
# Required because PgBouncer's transaction-mode pooler doesn't support the
# advisory locks Prisma migrations rely on.
DIRECT_URL=""

# Supabase project settings
# Find these at https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase Storage bucket name used for uploaded blog/portfolio images
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="media"
